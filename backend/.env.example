# ===== 复制本文件为 .env 后填写真实值：cp .env.example .env =====
# 注意：密码中的 @ 必须转义为 %40
DATABASE_URL=postgresql+asyncpg://aiops_user:CHANGE_ME%40password@127.0.0.1:5432/aiops

# Ollama OpenAI 兼容接口
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# 嵌入模型
EMBEDDING_MODEL=BAAI/bge-m3

# 安全配置（生成方式：openssl rand -hex 32）
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 监控与日志数据源
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100

# SOP 切片参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
